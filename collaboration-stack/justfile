set dotenv-load
set export
set shell := ["bash", "-lc"]

# List all recipes (default)
default:
    @just --list

import '../shared.just'

# Deploy the collaboration stack to kind with Helm, Traefik static config, and Linkerd policy
[group('local')]
deploy: _platform
    just _deploy "" false

# Deploy the collaboration stack with Keycloak/oauth2-proxy edge SSO enabled
[group('local')]
deploy-sso: _platform
    just _deploy "--set sso.enabled=true" true

[private]
_deploy HELM_ARGS SSO_ENABLED:
    kubectl create namespace collaboration --dry-run=client -o yaml | kubectl apply -f -
    kubectl annotate namespace collaboration linkerd.io/inject=enabled config.linkerd.io/default-inbound-policy=deny --overwrite
    helm upgrade --install collaboration-stack ../charts/collaboration-stack -n collaboration {{ HELM_ARGS }}
    just _wait {{ SSO_ENABLED }}
    linkerd check --proxy -n collaboration
    just _urls

# Remove collaboration stack resources
[group('local')]
clean:
    -helm uninstall collaboration-stack -n collaboration
    -kubectl delete namespace collaboration

# Smoke-test local routes through Traefik from inside the namespace.
[group('local')]
smoke:
    kubectl rollout status deploy/traefik -n collaboration --timeout=120s
    kubectl rollout status deploy/bookstack -n collaboration --timeout=300s
    kubectl rollout status deploy/kanboard -n collaboration --timeout=300s
    kubectl rollout status deploy/forgejo -n collaboration --timeout=300s
    kubectl run collab-curl --image=curlimages/curl:8.11.1 --restart=Never --rm -i --quiet -n collaboration -- sh -lc 'curl -fsS -H "Host: bookstack.localhost" http://traefik/login >/dev/null && curl -fsS -H "Host: kanboard.localhost" http://traefik/ >/dev/null && curl -fsS -H "Host: forgejo.localhost" http://traefik/ >/dev/null'
    @echo "Collaboration smoke test passed ✓"

# Show local UI access.
[group('local')]
urls: _urls

[private]
_wait SSO_ENABLED:
    kubectl wait --for=condition=Available deploy/bookstack-db -n collaboration --timeout=900s
    kubectl rollout restart deploy/bookstack -n collaboration
    kubectl rollout status deploy/bookstack -n collaboration --timeout=900s
    if [ "{{ SSO_ENABLED }}" = "true" ]; then kubectl wait --for=condition=Available deploy/keycloak -n collaboration --timeout=900s; kubectl wait --for=condition=Available deploy/oauth2-proxy -n collaboration --timeout=900s; fi
    kubectl wait --for=condition=Available deploy/traefik -n collaboration --timeout=900s
    kubectl wait --for=condition=Available deploy/kanboard -n collaboration --timeout=900s
    kubectl wait --for=condition=Available deploy/forgejo -n collaboration --timeout=900s

[private]
_urls:
    @echo "Run: kubectl -n collaboration port-forward svc/traefik 8080:80"
    @echo "Then open:"
    @echo "  BookStack: http://bookstack.localhost:8080"
    @echo "  Kanboard:  http://kanboard.localhost:8080"
    @echo "  Forgejo:   http://forgejo.localhost:8080"
    @echo "  Keycloak:  http://keycloak.localhost:8080  # only after just collab::deploy-sso"
    @echo "Keycloak demo user for SSO: demo / demo-password"
