set dotenv-load := true
set export := true
set shell := ["bash", "-lc"]

# List all recipes (default)
default:
    @just --list

import '../shared.just'

# --- EKS (requires AWS) ---

# Fast S3-to-S3 sync using AWS CLI. Usage:
#   AWS_PROFILE=your-profile just s3-copy s3://source-bucket/path s3://destination-bucket/path
[group('eks')]
s3-copy SRC DST: _awslogin
    aws configure set s3.max_concurrent_requests 3000
    aws configure set s3.max_queue_size 150000
    aws s3 sync "{{ SRC }}" "{{ DST }}" --only-show-errors

# Fast S3-to-S3 copy using rclone. Usage:
#   AWS_PROFILE=your-profile just rclone-s3-copy s3://source-bucket/path s3://destination-bucket/path
[group('eks')]
rclone-s3-copy SRC DST: _awslogin
    rclone copy "${SRC/s3:\/\//s3:}" "${DST/s3:\/\//s3:}" --config "{{ root_dir }}/rclone/example-rclone.conf" --progress --stats-one-line


# Create EKS cluster via Terraform
[group('eks')]
[working-directory('terraform')]
setup-eks: _awslogin _terraform-init
    terraform apply -auto-approve
    aws eks update-kubeconfig --name $(terraform output -raw cluster_name)
    kubectl get nodes || echo "Nodes starting (EKS Auto Mode)"

# Destroy EKS cluster
[confirm("This will destroy the EKS cluster. Continue?")]
[group('eks')]
[working-directory('terraform')]
destroy-eks: _awslogin
    terraform destroy -auto-approve

# Add current SSO user as cluster admin
[group('eks')]
eks-access CLUSTER=default_cluster: _awslogin
    aws eks create-access-entry --cluster-name {{ CLUSTER }} --principal-arn $(just _sso-role-arn) --type STANDARD || true
    aws eks associate-access-policy --cluster-name {{ CLUSTER }} --principal-arn $(just _sso-role-arn) \
      --policy-arn arn:aws:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy --access-scope type=cluster

# Deploy the databases Helm chart to EKS
[group('eks')]
deploy CLUSTER=default_cluster: _awslogin (_eks-kubeconfig CLUSTER)
    helm upgrade --install databases "{{ root_dir }}/charts/databases" -n databases --create-namespace
