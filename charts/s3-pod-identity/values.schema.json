{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "s3-pod-identity values",
  "type": "object",
  "additionalProperties": false,
  "required": ["aws", "bucket", "s3files", "jobs"],
  "properties": {
    "aws": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region"],
      "properties": {
        "region": {
          "type": "string",
          "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]$"
        }
      }
    },
    "bucket": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
    },
    "s3files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileSystemId"],
      "properties": {
        "fileSystemId": { "type": "string", "pattern": "^fs-[0-9a-f]+$" }
      }
    },
    "jobs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backup", "copy", "restore"],
      "properties": {
        "backup": { "type": "boolean" },
        "copy": { "type": "boolean" },
        "restore": { "type": "boolean" }
      }
    }
  }
}
