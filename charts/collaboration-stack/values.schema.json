{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "collaboration-stack values",
  "type": "object",
  "additionalProperties": false,
  "required": ["linkerd", "sso", "images"],
  "properties": {
    "linkerd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "sso": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bookstack", "kanboard"],
      "properties": {
        "bookstack": { "type": "string", "pattern": "^[^:]+:.+$" },
        "kanboard": { "type": "string", "pattern": "^[^:]+:.+$" }
      }
    }
  }
}
